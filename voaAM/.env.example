# Copie este arquivo para .env e preencha os valores localmente.
# Nunca publique .env ou chaves de API no GitHub.
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SESSION_COOKIE_SECURE=false

# Login Google opcional: Client ID OAuth tipo Web (Google Cloud Console).
GOOGLE_CLIENT_ID=

# Correção Gemini opcional: requer ativação expressa; padrão gratuito local.
ATIVAR_GEMINI=false
