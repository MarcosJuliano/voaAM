# Copie para .env.production no servidor e ajuste estes dois valores.
VOAAM_DOMINIO=estudos.exemplo.com
FLASK_SECRET_KEY=

# Ative o Ollama depois de baixar o modelo.
ATIVAR_OLLAMA=false
OLLAMA_MODEL=qwen3:0.6b
MODERAR_IMAGENS_PERFIL=false
REDACAO_IA_CONCORRENCIA=1

# Configuracoes opcionais para esta instalacao.
GOOGLE_CLIENT_ID=
ATIVAR_GEMINI=false

# E-mail de atendimento (domínio de envio precisa ser validado)
SUPPORT_EMAIL=
SUPPORT_FROM_EMAIL=
RESEND_API_KEY=

# Recuperação de senha: endereço HTTPS público que abre o frontend
PUBLIC_BASE_URL=https://seu-projeto.vercel.app
# Remetente verificado no Resend (pode ser igual a SUPPORT_FROM_EMAIL)
RESET_FROM_EMAIL=
